{
  "manifest_version": 3,
  "name": "3mien · Trợ giảng Pre-class có căn cứ",
  "version": "1.2.2",
  "description": "Trợ giảng AI có căn cứ (Track A1 - Nhóm 3mien) gắn trực tiếp trên preclass-online.com: trả lời kèm mã đoạn [Dxx-Syy · mm:ss], bấm để tua thẳng video/slide, hỏi ngược khi thiếu ngữ cảnh và từ chối ngoài bài.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://preclass-online.com/*",
    "https://*.preclass-online.com/*",
    "https://preclass.com/*",
    "https://*.preclass.com/*",
    "https://*/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "3mien · Trợ giảng Pre-class",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://preclass-online.com/*",
        "https://*.preclass-online.com/*",
        "https://preclass.com/*",
        "https://*.preclass.com/*"
      ],
      "js": [
        "page-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://preclass-online.com/*",
        "https://*.preclass-online.com/*",
        "https://preclass.com/*",
        "https://*.preclass.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
