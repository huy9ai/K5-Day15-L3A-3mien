{
  "manifest_version": 3,
  "name": "3mien · Trợ giảng Pre-class có căn cứ",
  "version": "1.3.2",
  "description": "Trợ giảng AI có căn cứ (Track A1 - Nhóm 3mien) cho cả 15 ngày Pre-class trên preclass-online.com: trích dẫn [Dxx-Syy · mm:ss], tua video/slide, hỏi đoạn đang xem, chip G9 1 chạm và bản nháp hỏi TA Discord.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://preclass-online.com/*",
    "https://*.preclass-online.com/*",
    "https://preclass.com/*",
    "https://*.preclass.com/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "3mien · Trợ giảng Pre-class",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://preclass-online.com/*",
        "https://*.preclass-online.com/*",
        "https://preclass.com/*",
        "https://*.preclass.com/*"
      ],
      "js": [
        "page-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://preclass-online.com/*",
        "https://*.preclass-online.com/*",
        "https://preclass.com/*",
        "https://*.preclass.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
